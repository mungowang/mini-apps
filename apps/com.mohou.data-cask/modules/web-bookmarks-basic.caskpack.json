{
  "version": 1,
  "kind": "caskpack",
  "moduleId": "web-bookmarks-basic",
  "name": "网页书签",
  "title": "网页书签",
  "description": "分类 · 作用域 · 链接。控制台、文档、内部页一张图找齐。",
  "recommended": false,
  "exportedAt": 0,
  "schemas": [
    {
      "name": "分类",
      "display": "{name}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "code", "type": "string", "search": true },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "作用域",
      "display": "{code}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "code", "type": "string", "search": true },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "书签",
      "display": "{title}",
      "fields": [
        { "key": "title", "type": "string", "label": true, "search": true },
        { "key": "url", "type": "url", "search": true },
        { "key": "category", "type": "ref", "schemaName": "分类", "search": true },
        { "key": "scope", "type": "ref", "schemaName": "作用域", "search": true },
        { "key": "owner", "type": "string", "search": true },
        { "key": "secretNote", "type": "secret" },
        { "key": "note", "type": "text" }
      ]
    }
  ],
  "views": [
    {
      "name": "书签一览",
      "description": "全部入口。按分类 / 作用域 / 标签筛选后复制链接。",
      "illustration": "collection",
      "schemaName": "书签",
      "allowWrite": true,
      "columns": [
        { "key": "category.name", "as": "分类", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "scope.code", "as": "作用域", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "title", "as": "标题", "show": true, "search": true, "sort": true },
        { "key": "$tags", "as": "标签", "show": true, "search": true, "sort": false, "enum": true },
        { "key": "url", "as": "链接", "show": true, "search": true, "sort": false, "enum": false },
        { "key": "owner", "as": "维护人", "show": true, "search": true, "sort": false, "enum": true },
        { "key": "note", "as": "备注", "show": true, "search": true, "sort": false, "enum": false },
        { "key": "secretNote", "as": "访问说明", "show": false, "search": false, "sort": false, "enum": false }
      ],
      "shortcuts": [
        {
          "id": "bm-pin",
          "name": "钉选",
          "filters": { "$tags": "pin" },
          "sorts": [{ "key": "title", "dir": "asc" }]
        },
        {
          "id": "bm-internal",
          "name": "内部",
          "filters": { "$tags": "internal" },
          "sorts": [{ "key": "title", "dir": "asc" }]
        },
        {
          "id": "bm-stg",
          "name": "STG",
          "filters": { "scope.code": "STG" },
          "sorts": [{ "key": "title", "dir": "asc" }]
        }
      ]
    },
    {
      "name": "常用钉选",
      "description": "标签含 pin 的入口。",
      "illustration": "notes",
      "schemaName": "书签",
      "allowWrite": true,
      "baseFilters": [{ "key": "$tag", "op": "hasTag", "value": "pin" }],
      "columns": [
        { "key": "title", "as": "标题", "show": true, "search": true, "sort": true },
        { "key": "url", "as": "链接", "show": true, "search": true, "sort": false },
        { "key": "category.name", "as": "分类", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "scope.code", "as": "作用域", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "$tags", "as": "标签", "show": true, "search": true, "sort": false, "enum": true }
      ],
      "shortcuts": []
    },
    {
      "name": "控制台",
      "description": "分类 = 控制台。",
      "illustration": "data",
      "schemaName": "书签",
      "allowWrite": true,
      "baseFilters": [{ "key": "category.code", "op": "eq", "value": "console" }],
      "columns": [
        { "key": "title", "as": "标题", "show": true, "search": true, "sort": true },
        { "key": "url", "as": "链接", "show": true, "search": true, "sort": false },
        { "key": "scope.code", "as": "作用域", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "$tags", "as": "标签", "show": true, "search": true, "sort": false, "enum": true },
        { "key": "note", "as": "备注", "show": true, "search": true, "sort": false }
      ],
      "shortcuts": [
        {
          "id": "bm-console-stg",
          "name": "STG",
          "filters": { "scope.code": "STG" },
          "sorts": [{ "key": "title", "dir": "asc" }]
        }
      ]
    },
    {
      "name": "STG 入口",
      "description": "作用域 = STG 的链接。",
      "illustration": "filter",
      "schemaName": "书签",
      "allowWrite": true,
      "baseFilters": [{ "key": "scope.code", "op": "eq", "value": "STG" }],
      "columns": [
        { "key": "title", "as": "标题", "show": true, "search": true, "sort": true },
        { "key": "url", "as": "链接", "show": true, "search": true, "sort": false },
        { "key": "category.name", "as": "分类", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "$tags", "as": "标签", "show": true, "search": true, "sort": false, "enum": true }
      ],
      "shortcuts": []
    }
  ],
  "samples": [
