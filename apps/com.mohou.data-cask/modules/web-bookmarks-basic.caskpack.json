    { "schemaName": "分类", "packId": "cat-console", "data": { "name": "控制台", "code": "console", "note": "业务后台" }, "tags": [] },
    { "schemaName": "分类", "packId": "cat-design", "data": { "name": "设计", "code": "design", "note": "" }, "tags": [] },
