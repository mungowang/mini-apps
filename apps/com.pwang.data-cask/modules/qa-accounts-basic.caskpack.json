{
  "version": 1,
  "kind": "caskpack",
  "moduleId": "qa-accounts-basic",
  "name": "测试账号",
  "title": "测试账号",
  "description": "环境 · 系统 · 租户 · 角色 · 账号。多租户业务系统 + 第三方服务账号。",
  "recommended": true,
  "exportedAt": 0,
  "schemas": [
    {
      "name": "环境",
      "display": "{code}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "code", "type": "string", "search": true },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "系统",
      "display": "{name} · {env.code}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "env", "type": "ref", "schemaName": "环境" },
        { "key": "baseUrl", "type": "url" },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "租户",
      "display": "{code} · {name}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "code", "type": "string", "search": true },
        { "key": "system", "type": "ref", "schemaName": "系统" },
        { "key": "baseUrl", "type": "url" },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "角色",
      "display": "{name} · {system.name}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "code", "type": "string", "search": true },
        { "key": "system", "type": "ref", "schemaName": "系统" },
        { "key": "note", "type": "text" }
      ]
    },
    {
      "name": "账号",
      "display": "{name}",
      "fields": [
        { "key": "name", "type": "string", "label": true, "search": true },
        { "key": "system", "type": "ref", "schemaName": "系统" },
        { "key": "tenant", "type": "ref", "schemaName": "租户" },
        { "key": "role", "type": "ref", "schemaName": "角色" },
        { "key": "username", "type": "string", "search": true },
        { "key": "password", "type": "secret" },
        { "key": "note", "type": "text" }
      ]
    }
  ],
  "views": [
    {
      "name": "账号一览",
      "description": "按系统 / 租户 / 角色查找测试账号。多租户入口看租户 URL，第三方服务看系统入口。",
      "illustration": "account",
      "schemaName": "账号",
      "columns": [
        { "key": "name", "as": "名称", "show": true, "search": true, "sort": true, "enum": false },
        { "key": "username", "as": "用户名", "show": true, "search": true, "sort": true, "enum": false },
        { "key": "tenant.code", "as": "租户编码", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "tenant.name", "as": "租户", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "role.name", "as": "角色", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "system.name", "as": "系统", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "system.env.code", "as": "环境", "show": true, "search": true, "sort": true, "enum": true },
        { "key": "tenant.baseUrl", "as": "租户入口", "show": true, "search": false, "sort": false },
        { "key": "system.baseUrl", "as": "系统入口", "show": true, "search": false, "sort": false },
        { "key": "password", "as": "密码", "show": true, "search": false, "sort": false }
      ],
      "shortcuts": [
        {
          "id": "sc-biz",
          "name": "业务系统",
          "filters": { "system.name": "业务系统" },
          "sorts": [{ "key": "name", "dir": "asc" }]
        },
        {
          "id": "sc-jiguang",
          "name": "极光推送",
          "filters": { "system.name": "极光推送" },
          "sorts": [{ "key": "name", "dir": "asc" }]
        },
        {
          "id": "sc-kiro",
          "name": "Kiro",
          "filters": { "system.name": "Kiro" },
          "sorts": [{ "key": "name", "dir": "asc" }]
        },
        {
          "id": "sc-stg",
          "name": "STG",
          "filters": { "system.env.code": "STG" },
          "sorts": [{ "key": "name", "dir": "asc" }]
        }
      ]
    }
  ],
